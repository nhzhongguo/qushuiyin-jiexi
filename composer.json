{
    "name": "5ime/video_spider",
    "description": "一款高效的短视频去水印下载工具。",
    "type": "project",
    "version": "2.0.0",
    "license": "AGPL-3.0",
    "authors": [
        {
            "name": "iami233",
            "email": "me@5ime.cn"
        }
    ],
    "require": {
        "php": ">=8.1",
        "ext-curl": "*",
        "ext-json": "*",
        "vlucas/phpdotenv": "^5.6",
        "symfony/cache": "^6.4",
        "symfony/rate-limiter": "^6.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "mockery/mockery": "^1.6"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "serve": "php -S localhost:8000 -t public public/router.php",
        "serve:full": "node scripts/a_bogus_server.js & php -S localhost:8000 -t public public/router.php",
        "lint": "@php bin/lint.php",
        "smoke": "@php bin/smoke.php",
        "cache:clear": "@php -r \"require 'vendor/autoload.php'; echo \\\\App\\\\Services\\\\ParseCache::cleanup();\"",
        "test": "phpunit",
        "test:coverage": "phpunit --coverage-html coverage"
    },
    "config": {
        "platform": {
            "php": "8.1.0"
        },
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}



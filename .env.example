# 应用配置
APP_NAME=VideoSpider
APP_DEBUG=false
APP_CORS_ALLOW_ORIGIN=*
APP_ENV=production

# API 速率限制配置
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_REQUESTS=60
RATE_LIMIT_TIME_WINDOW=60
# 仅在应用部署在可信反向代理后启用
RATE_LIMIT_TRUST_PROXY_HEADERS=false
# 限流检查异常时是否放行
RATE_LIMIT_FAIL_OPEN=false

# CURL 配置
CURL_CONNECT_TIMEOUT=5
CURL_TIMEOUT=10
CURL_MAX_RETRIES=3
# Windows 若 PHP 未配置 CA，可填写 cacert.pem 的绝对路径
# CURL_CA_BUNDLE=

# 抖音解析依赖 Node.js 生成 a_bogus 签名
DOUYIN_NODE_BIN=node
# 可选：自定义 a_bogus 脚本路径
# DOUYIN_A_BOGUS_SCRIPT=
# 可选：a_bogus 签名服务端口
A_BOGUS_PORT=9876

# Cookie 配置
# 微博解析需要有效 Cookie
WEIBO_COOKIE=''

# 解析缓存配置
PARSE_CACHE_ENABLED=true
PARSE_CACHE_TTL=86400
PARSE_CACHE_DRIVER=file
# PARSE_CACHE_DRIVER=redis
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_DATABASE=0

# 速率限制缓存配置
RATE_LIMIT_CACHE_ENABLED=true
RATE_LIMIT_CACHE_DRIVER=file

# API Key 鉴权（可选开启；开启后除 /api/v1/health 外均需携带 X-API-Key 或 Authorization: Bearer）
API_KEY_ENABLED=false
# 建议使用强随机字符串，例如：openssl rand -hex 24
API_KEY=

# 媒体代理配置
MEDIA_PROXY_ENABLED=true
MEDIA_PROXY_MAX_SIZE=524288000
# MEDIA_PROXY_ALLOWED_DOMAINS=

# 日志配置
LOG_LEVEL=error
LOG_MAX_FILES=30
